{
  "version": 1,
  "id": "screen-performance-mix-small-batch",
  "name": "Bin a small high-performance DRAM product mix",
  "description": "Runs an explicit four-device reliability and speed-bin batch with a fixed setup/load overhead and a two-performance, one-automotive, one-commercial disposition.",
  "category": "final-test",
  "tags": [
    "dram",
    "back-end",
    "burn-in",
    "final-test",
    "speed-bin",
    "reliability",
    "small-batch"
  ],
  "setupGroup": "reliability-screen",
  "durationTicks": 17000,
  "inputs": [
    {
      "resource": "packaged-dram-device",
      "count": 4
    }
  ],
  "outputs": [
    {
      "resource": "performance-dram-device",
      "count": 2
    },
    {
      "resource": "automotive-dram-device",
      "count": 1
    },
    {
      "resource": "commercial-dram-device",
      "count": 1
    }
  ]
}
